# Copy this file to .env and fill in the values before using the mstTestnet
# network. .env is gitignored; never commit real values.

# MST testnet JSON-RPC endpoint.
MST_RPC_URL=

# MST testnet chain ID.
MST_CHAIN_ID=

# Private key of a dedicated, testnet-only deployer wallet. Never reuse a key
# that holds mainnet funds.
DEPLOYER_PRIVATE_KEY=
